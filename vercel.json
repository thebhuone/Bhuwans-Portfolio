{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/Bhuwan_Bhandari_CV.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Bhuwan_Bhandari_CV.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
